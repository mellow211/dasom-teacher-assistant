# 서버에서만 사용하는 Replicate API 토큰입니다. 브라우저에 노출되는 NEXT_PUBLIC_ 접두사를 사용하지 마세요.
REPLICATE_API_TOKEN=your_replicate_api_token

# 선택 사항: 지정하지 않으면 openai/gpt-5.6-terra를 사용합니다.
REPLICATE_MODEL=openai/gpt-5.6-terra

# Supabase Auth와 사용자별 학급 데이터 연결에 사용합니다. 서버 환경변수로만 설정하세요.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_OWNER_SECRET=use_a_random_secret_of_at_least_32_characters
